    {
      "chartSpecId": "dashboard.kpi.vrm.footfall",
      "fixtureId": "golden_dashboard_kpi_activity",
      "id": "kpi-vrm-footfall",
      "inlineSpec": {
        "chartType": "single_value",
        "dataset": "events",
        "dimensions": [
          {
            "bucket": "15_MIN",
            "column": "timestamp",
            "id": "timestamp",
            "sort": "asc"
          }
        ],
        "displayHints": {
          "carryForward": true
        },
        "id": "dashboard.kpi.vrm.footfall",
        "interactions": {
