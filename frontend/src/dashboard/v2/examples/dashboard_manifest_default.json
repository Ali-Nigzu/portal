      "id": "kpi-vrm-exits",
      "inlineSpec": {
        "chartType": "single_value",
        "dataset": "events",
        "dimensions": [
          {
            "bucket": "15_MIN",
            "column": "timestamp",
            "id": "timestamp",
            "sort": "asc"
          }
        ],
        "displayHints": {
          "carryForward": true
        },
        "id": "dashboard.kpi.vrm.exits",
