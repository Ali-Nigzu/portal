{
  "id": "dashboard-default",
  "layout": {
    "grid": {
      "columns": 12,
      "placements": {
        "live-flow": {
          "h": 8,
          "w": 12,
          "x": 0,
          "y": 0
        }
      }
    },
    "kpiBand": [
      "kpi-vrm-entrances",
      "kpi-vrm-occupancy",
      "kpi-vrm-exits",
      "kpi-vrm-footfall",
      "kpi-vrm-dwell",
      "kpi-vrm-traffic",
      "kpi-vrm-capacity"
    ]
  },
  "orgId": "storybook",
  "timeControls": {
    "defaultTimeRangeId": "all_time",
    "options": [
      {
        "bucket": "WEEK",
        "durationMinutes": null,
        "id": "all_time",
        "label": "All time",
        "allTime": true
      },
      {
        "bucket": "5_MIN",
        "durationMinutes": 60,
        "id": "last_60_minutes",
        "label": "Last 60 minutes"
      },
      {
        "bucket": "HOUR",
        "durationMinutes": 1440,
        "id": "last_24_hours",
        "label": "Last 24 hours"
      },
      {
        "bucket": "DAY",
        "durationMinutes": 10080,
        "id": "last_7_days",
        "label": "Last 7 days"
      }
    ],
    "timezone": "UTC"
  },
  "widgets": [
    {
      "chartSpecId": "dashboard.kpi.vrm.entrances",
      "fixtureId": "golden_dashboard_kpi_entrances",
      "id": "kpi-vrm-entrances",
      "inlineSpec": {
        "chartType": "single_value",
        "dataset": "events",
        "dimensions": [
          {
            "bucket": "15_MIN",
            "column": "timestamp",
            "id": "timestamp",
            "sort": "asc"
          }
        ],
        "displayHints": {
          "carryForward": true
        },
        "id": "dashboard.kpi.vrm.entrances",
        "interactions": {
          "export": [
            "png",
            "csv"
          ]
        },
        "measures": [
          {
            "aggregation": "count",
            "eventTypes": [
              1
            ],
            "id": "entrances",
            "label": "Entrances"
          }
        ],
        "notes": [
          "Entrances every 15 minutes"
        ],
        "timeWindow": {
          "bucket": "15_MIN",
          "from": "{{NOW_MINUS_24_HOURS}}",
          "timezone": "UTC",
          "to": "{{NOW}}"
        }
      },
      "kind": "kpi",
      "title": "Grid",
      "subtitle": "Entrances",
      "locked": true,
      "fixedTimeWindow": {
        "bucket": "15_MIN",
        "durationMinutes": 1440
      }
    },
    {
      "chartSpecId": "dashboard.kpi.vrm.occupancy",
      "fixtureId": "golden_dashboard_kpi_live_occupancy",
      "id": "kpi-vrm-occupancy",
      "inlineSpec": {
        "chartType": "single_value",
        "dataset": "events",
        "dimensions": [
          {
            "bucket": "15_MIN",
            "column": "timestamp",
            "id": "timestamp",
            "sort": "asc"
          }
        ],
        "displayHints": {
          "carryForward": true
        },
        "id": "dashboard.kpi.vrm.occupancy",
        "interactions": {
          "export": [
            "png",
            "csv"
          ]
        },
        "measures": [
          {
            "aggregation": "occupancy_recursion",
            "id": "occupancy",
            "label": "Occupancy"
          }
        ],
        "notes": [
          "Occupancy per 15 minutes"
        ],
        "timeWindow": {
          "bucket": "15_MIN",
          "from": "{{NOW_MINUS_24_HOURS}}",
          "timezone": "UTC",
          "to": "{{NOW}}"
        }
      },
      "kind": "kpi",
      "title": "AC Load",
      "subtitle": "Occupancy",
      "locked": true,
      "fixedTimeWindow": {
        "bucket": "15_MIN",
        "durationMinutes": 1440
      }
    },
    {
      "chartSpecId": "dashboard.kpi.vrm.exits",
