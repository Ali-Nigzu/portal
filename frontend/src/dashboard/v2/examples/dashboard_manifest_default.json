      "fixtureId": "golden_dashboard_kpi_traffic_distribution",
      "id": "kpi-vrm-traffic",
      "inlineSpec": {
        "chartType": "categorical",
        "dataset": "events",
        "dimensions": [
          {
            "column": "camera_id",
            "id": "camera_id",
            "sort": "desc"
          }
        ],
        "displayHints": {
          "carryForward": true
        },
        "id": "dashboard.kpi.vrm.traffic_distribution",
        "interactions": {
          "export": [
