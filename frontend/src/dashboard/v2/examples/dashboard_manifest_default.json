          ]
        },
        "measures": [
          {
            "aggregation": "count",
            "eventTypes": [
              0
            ],
            "id": "exits",
            "label": "Exits"
          }
        ],
        "notes": [
          "Exits every 15 minutes"
        ],
        "timeWindow": {
          "bucket": "15_MIN",
          "from": "{{NOW_MINUS_24_HOURS}}",
          "timezone": "UTC",
          "to": "{{NOW}}"
